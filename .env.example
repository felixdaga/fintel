# Copy to `.env/keys.env` and fill in values. The `.env/` directory is gitignored.
#
#   mkdir -p .env && cp .env.example .env/keys.env
#
# `fintel simulation` loads these into the process env (without overwriting
# variables already set in your shell). Never commit `.env/`.

# ── LLM / agent ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Market data providers (bind only what your package needs) ───────────────
MASSIVE_API_KEY=
BRAVE_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Optional runtime ────────────────────────────────────────────────────────
# FINTEL_CACHE=runs/cache
# FINTEL_OFFLINE=0
